{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsessionrecord.org/schema/v0/agent-session.schema.json",
  "title": "Agent Session Record 0.1 record",
  "allOf": [
    {
      "$ref": "#/$defs/Envelope"
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "session"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/record.session"
