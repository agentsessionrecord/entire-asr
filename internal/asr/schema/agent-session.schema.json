          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/record.gap"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "type": "string",
            "pattern": "/"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)+/[^/\\s]+(?![\\s\\S])"
          }
        },
        "x-asr": "ASR-017"
      }
    }
